# MongoDB Atlas (or any MongoDB) connection string
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/?retryWrites=true&w=majority"
# Optional, defaults to "breakfeast"
MONGODB_DB="breakfeast"

# Exact origin of the deployed app, used for CSRF checks.
# Defaults to http://localhost:3000 in development; required in production.
APP_ORIGIN="https://breakfeast.example.netlify.app"
# Optional extra allowed origins, comma-separated (e.g. a custom domain)
APP_ALLOWED_ORIGINS=""

# Optional, defaults to "bf" (cookies: bf_session, bf_admin, bf_device)
COOKIE_PREFIX="bf"

# Trusted client IP for rate limiting and monitoring.
# Netlify: x-nf-client-connection-ip. Vercel/Render/Fly/Heroku: x-forwarded-for with 1 hop.
# Cloudflare in front: cf-connecting-ip. Own nginx setting X-Real-IP: x-real-ip. No proxy: socket.
CLIENT_IP_SOURCE="x-nf-client-connection-ip"
TRUSTED_PROXY_HOPS="1"

# IP geolocation: ip-api (free, HTTP only, non-commercial), ipinfo (needs GEOIP_TOKEN), or none
GEOIP_PROVIDER="ip-api"
GEOIP_TOKEN=""

# Optional overrides of the session and retention defaults
# USER_SESSION_IDLE_DAYS="30"
# USER_SESSION_MAX_DAYS="90"
# ADMIN_SESSION_IDLE_MIN="30"
# ADMIN_SESSION_MAX_HOURS="12"
# ACTIVITY_RETENTION_DAYS="30"
# ACCESS_RETENTION_DAYS="365"

# Optional overrides of the account-sharing flag thresholds (shown on the admin Alerts page)
# SHARING_FAR_KM="100"                  # "Far from last location"
# SHARING_IMPOSSIBLE_KMH="500"          # "Impossible travel"
# SHARING_CONCURRENT_WINDOW_MIN="15"    # "Two devices at once"
# SHARING_FAILED_LOGINS="3"             # "Repeated failed logins" within 15 minutes
# SHARING_ALERT_THROTTLE_HOURS="6"      # Reserved for alert emails (not sent)
